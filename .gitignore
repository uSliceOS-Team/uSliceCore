# Build artifacts from tests/run_tests.sh (binaries have no extension on
# Linux/macOS -- see tests/README.md).
tests/.build/

# Per-developer editor state. Shared clangd configuration lives in .clangd
# and compile_flags.txt instead. tasks.json/launch.json are the exception:
# they wire the DSL generator in as a pre-build step (see
# examples/logic_controlled_tasks/README.md), so they are tracked for
# everyone rather than left to each person to recreate.
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json

# Build artifact from examples/logic_controlled_tasks (see its README).
examples/logic_controlled_tasks/example
build/

# Generic fallback for the above on other platforms.
*.exe
*.bin

# Local MISRA rule texts built from a purchased copy of the standard.
# Never commit this -- see docs/MISRA_COMPLIANCE.md.
tools/misra_rule_texts.txt
