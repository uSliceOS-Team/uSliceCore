# Task order is scheduler order. Cases become values of the generated enum used
# by the task's Loop_<task> switch.
namespace example::tasks
main "main.cpp"
definitions "TaskDefinitions.hpp"

task ledBlinker with autostart {
    case BLINK
    case DONE
}

task motor {
    case RUN
}

task sensorMonitor with autostart {
    case READ
    case CHECK
}

task logic with autostart {
    case INIT
    case MONITOR
}
